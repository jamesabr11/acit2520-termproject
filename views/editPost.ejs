<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.classless.min.css"
    />
    <link href="/css/style.css" rel="stylesheet" />
    <title>Edit Post</title>
  </head>
  <body>
    <main>
      <div class="authOptions">
        <h1>Edit Post</h1>
        <div>
          <a role="button" href="/posts/show/<%= post.id %>" class="outline">Cancel</a>
        </div>
      </div>

      <hr>

      <form action="/posts/edit/<%= post.id %>" method="POST">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= post.title %>" required>

        <label for="link">Link</label>
        <input type="url" id="link" name="link" value="<%= post.link %>">

        <label for="description">Description</label>
        <textarea id="description" name="description" rows="5" required><%= post.description %></textarea>

        <label for="subgroup">Subgroup (Cannot be changed after posting)</label>
        <input type="text" id="subgroup" name="subgroup" value="<%= post.subgroup %>" readonly>

        <button type="submit">Save Changes</button>
      </form>
    </main>
  </body>
</html>